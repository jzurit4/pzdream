function Contacto() {
  const usuario = localStorage.getItem('userName');

  const publicacionesIniciales = [
    {
        id: 1,
        type: 'duda',
        title: 'Compatibilidad de RAM con Ryzen 7000',
        content:
        '¿Es preferible ir por 6000MHz CL30 o la diferencia frente a CL36 es mínima en juegos?',
        author: 'Usuario',
        replies: [],
