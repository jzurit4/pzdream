  padding: 0.4rem 1.2rem;
  border-radius: 20px;
  background-color: #e9ecef;
  border: none;
  font-size: 0.9rem;
  transition: all 0.3s ease;
}

.quick-categories .category-btn:hover {
  background-color: #007bff;
  color: white;
  transform: translateY(-2px);
}

.quick-categories .category-btn i {
  margin-right: 5px;
}

@media (max-width: 576px) {
  .search-section .btn-search {
    padding: 0.5rem 1rem;
  }
  .search-section .btn-search span {
    display: none;
  }
  .search-section .btn-search i {
    margin-right: 0;
  }
}

.footer {
  background-color: #2d3436;
  color: #dfe6e9;
  padding: 3rem 0 1.5rem 0;
  margin-top: 2rem;
}

.footer-title {
  color: #ffffff;
  font-weight: 600;
  margin-bottom: 1.2rem;
  font-size: 1.1rem;
}

.footer-text {
  font-size: 0.95rem;
  line-height: 1.6;
  color: #b2bec3;
}

.social-icons {
  margin-top: 1rem;
}

.social-link {
  display: inline-block;
  width: 38px;
  height: 38px;
  background-color: rgba(255, 255, 255, 0.1);
  color: #dfe6e9;
  text-align: center;
  line-height: 38px;
  border-radius: 50%;
  margin-right: 8px;
  transition: all 0.3s ease;
  font-size: 0.9rem;
}

.social-link:hover {
  background-color: #007bff;
  color: white;
  transform: translateY(-3px);
  text-decoration: none;
}

.footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-links li {
  margin-bottom: 0.6rem;
}

.footer-links a {
  color: #b2bec3;
  text-decoration: none;
  transition: all 0.3s ease;
  font-size: 0.95rem;
}

.footer-links a:hover {
  color: #007bff;
  padding-left: 5px;
}

.footer-links li i {
  color: #007bff;
  width: 20px;
}

.footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  padding-top: 1.5rem;
  margin-top: 1rem;
  text-align: center;
}

.footer-bottom p {
  font-size: 0.9rem;
  color: #b2bec3;
}

@media (max-width: 768px) {
  .footer {
    padding: 2rem 0 1rem 0;
  }

  .footer-title {
    margin-top: 1rem;
  }
}

.carousel-wrapper {
  position: relative;
  background-color: #e3f2fd;
  border-radius: 12px;
  padding: 1rem 1rem 2rem 1rem;
  margin-bottom: 2rem;
  overflow: hidden;
}

.wave-background {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 80px;
  z-index: 0;
  pointer-events: none;
}

.wave-background svg {
  display: block;
  width: 100%;
  height: 100%;
}

.carousel-container {
  position: relative;
  z-index: 1;
}

@media (max-width: 768px) {
  .wave-background {
    height: 50px;
  }
  .carousel-wrapper {
    padding-bottom: 1.5rem;
  }
}

.product-section {
  padding: 0.5rem 0;
}

.section-title {
  font-size: 1.6rem;
  font-weight: 600;
  color: #2d3436;
}

.see-all {
  font-weight: 500;
  color: #007bff;
  transition: all 0.3s ease;
}

.see-all:hover {
  color: #0056b3;
  transform: translateX(3px);
}

.product-card {
  display: block;
  background: #ffffff;
  border-radius: 12px;
  padding: 0.8rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  height: 100%;
  position: relative;
  color: #2d3436;
}

.product-card:hover {
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  transform: translateY(-5px);
}

.product-card img {
  width: 100%;
  height: 150px;
  object-fit: contain;
  background: #f8f9fa;
  border-radius: 8px;
}

.product-card h6 {
  font-size: 0.95rem;
  margin-top: 0.6rem !important;
  margin-bottom: 0.25rem;
  font-weight: 600;
  color: #2d3436;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-card .price {
  font-size: 1.1rem;
  font-weight: 700;
  color: #e74c3c;
  margin-bottom: 0;
}

.product-card .old-price {
  font-size: 0.85rem;
  font-weight: 400;
  color: #b2bec3;
  text-decoration: line-through;
  margin-right: 0.5rem;
}

.badge-oferta {
  position: absolute;
  top: 12px;
  left: 12px;
  background: #e74c3c;
  color: #fff;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.25rem 0.6rem;
  border-radius: 20px;
  z-index: 2;
  box-shadow: 0 2px 6px rgba(231, 76, 60, 0.3);
}

.custom-carousel-control {
  width: 5%;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  opacity: 0.7;
  transition: opacity 0.3s ease;
  height: 50px;
  top: 50%;
  transform: translateY(-50%);
  margin: 0 5px;
}

.custom-carousel-control:hover {
  opacity: 1;
  background: #fff;
}

.custom-carousel-control .carousel-control-prev-icon,
.custom-carousel-control .carousel-control-next-icon {
  background-color: #2d3436;
  border-radius: 50%;
  padding: 12px;
  background-size: 60%;
}

@media (max-width: 768px) {
  .section-title {
    font-size: 1.3rem;
  }
  .product-card img {
    height: 120px;
  }
  .product-card h6 {
    font-size: 0.85rem;
  }
  .product-card .price {
    font-size: 1rem;
  }
  .custom-carousel-control {
    height: 40px;
    width: 40px;
  }
  .custom-carousel-control .carousel-control-prev-icon,
  .custom-carousel-control .carousel-control-next-icon {
    padding: 8px;
  }
  .badge-oferta {
    font-size: 0.65rem;
    padding: 0.15rem 0.5rem;
  }
}

@media (max-width: 576px) {
  .product-card img {
    height: 100px;
  }
}


/* ===== PÁGINA "NOSOTROS" ===== */
/* BANNER */
.about-banner {
  position: relative;
  width: 100%;
  height: 350px;
  overflow: hidden;
  background-color: #2d3436; /* color de respaldo */
}

.about-banner-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.about-banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45); /* oscurece la imagen para legibilidad */
  color: white;
  text-align: center;
  padding: 0 1.5rem;
}

.about-banner-title {
  font-size: 3rem;
  font-weight: 700;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  margin-bottom: 0.5rem;
}

.about-banner-sub {
  font-size: 1.3rem;
  font-weight: 300;
  opacity: 0.9;
  text-shadow: 0 1px 6px rgba(0, 0, 0, 0.2);
}

/* TEXTO INFORMATIVO  */
.about-title {
  font-weight: 600;
  color: #2d3436;
}

.about-text {
  font-size: 1.1rem;
  line-height: 1.8;
  color: #4a4a4a;
  margin-bottom: 1.2rem;
}

.about-feature {
  background: #f8f9fa;
  border-radius: 12px;
  padding: 1.8rem 1rem;
  transition: transform 0.2s, box-shadow 0.2s;
  height: 100%;
}

.about-feature:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
}

.about-feature i {
  color: #007bff;
}

.about-feature h5 {
  font-weight: 600;
  color: #2d3436;
}

/* RESPONSIVO*/
@media (max-width: 768px) {
  .about-banner {
    height: 250px;
  }
  .about-banner-title {
    font-size: 2.2rem;
  }
  .about-banner-sub {
    font-size: 1rem;
  }
  .about-text {
    font-size: 1rem;
  }
}

@media (max-width: 576px) {
  .about-banner {
    height: 200px;
  }
  .about-banner-title {
    font-size: 1.6rem;
  }
}
/* ===== ESTILOS PARA PÁGINA DE DETALLE DE PRODUCTO ===== */
/* Contenedor de imagen  */
.product-image-container {
  position: relative;
  background: #f8f9fa;
  border-radius: 12px;
  padding: 1rem;
  text-align: center;
  min-height: 300px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-image-container img {
  max-height: 500px;
  width: 100%;
  object-fit: contain;
}

/*  Badge de oferta (detalle) */
.badge-oferta-detalle {
  position: absolute;
  top: 20px;
  right: 20px;
  background: #dc3545;
  color: #fff;
  padding: 0.5rem 1rem;
  border-radius: 30px;
  font-size: 1.1rem;
  font-weight: 700;
  box-shadow: 0 4px 12px rgba(220, 53, 69, 0.4);
  z-index: 2;
}

/*Precios  */
.price-detalle {
  font-size: 2.2rem;
  font-weight: 700;
  color: #007bff;
}

.old-price-detalle {
  font-size: 1.3rem;
  color: #b2bec3;
  text-decoration: line-through;
  margin-right: 1rem;
}

/* Lista de especificaciones  */
.product-specs-list .list-group-item {
  background: transparent;
  border-color: #e9ecef;
  padding: 0.75rem 0;
}

.product-specs-list .list-group-item:first-child {
  border-top: none;
}

/*Ajustes responsivos*/
@media (max-width: 768px) {
  .price-detalle {
    font-size: 1.8rem;
  }
  .badge-oferta-detalle {
    font-size: 0.9rem;
    padding: 0.3rem 0.8rem;
    top: 12px;
    right: 12px;
  }
  .product-image-container {
    min-height: 200px;
    padding: 0.5rem;
  }
  .product-image-container img {
    max-height: 300px;
  }
}

@media (max-width: 576px) {
  .price-detalle {
    font-size: 1.5rem;
  }
  .old-price-detalle {
    font-size: 1rem;
  }
}
/* ===== BOTONES DEL CARRUSEL DE PRODUCTOS ===== */

.product-carousel {
  position: relative;
  padding: 0 35px;
}

.product-carousel-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 5;

  width: 42px;
  height: 42px;
  border: none;
  border-radius: 50%;

  background-color: #ffffff;
  color: #007bff;
  font-size: 20px;
  font-weight: bold;

  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.18);
  cursor: pointer;
  transition: all 0.25s ease;
}

.product-carousel-btn:hover {
  background-color: #007bff;
  color: #ffffff;
  transform: translateY(-50%) scale(1.08);
}

.product-carousel-btn.prev {
  left: -5px;
}

.product-carousel-btn.next {
  right: -5px;
}

.product-carousel-btn:focus-visible {
  outline: 3px solid #80bdff;
  outline-offset: 3px;
}

/* Ajustes para móviles */
@media (max-width: 576px) {
  .product-carousel {
    padding: 0 10px;
  }

  .product-carousel-btn {
    width: 32px;
    height: 32px;
    font-size: 16px;
    background-color: #007bff;
    color: #ffffff;
  }

  .product-carousel-btn.prev {
    left: -8px;
  }

  .product-carousel-btn.next {
    right: -8px;
  }
}
