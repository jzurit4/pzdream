  margin-bottom: 0.5rem;
}

.about-banner-sub {
  font-size: 1.3rem;
  font-weight: 300;
  opacity: 0.9;
  text-shadow: 0 1px 6px rgba(0, 0, 0, 0.2);
}

/* TEXTO INFORMATIVO  */
.about-title {
  font-weight: 600;
  color: #2d3436;
}

.about-text {
  font-size: 1.1rem;
  line-height: 1.8;
  color: #4a4a4a;
  margin-bottom: 1.2rem;
}

.about-feature {
  background: #f8f9fa;
  border-radius: 12px;
  padding: 1.8rem 1rem;
