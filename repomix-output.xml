  const [replyOpen, setReplyOpen] = useState(null);

  // Crear publicación
  const handleSubmit = (e) => {
    e.preventDefault();

    if (!usuario) {
      alert('Debes iniciar sesión para publicar una consulta.');
      return;
    }

    if (!type || !title.trim() || !content.trim()) {
      return;
    }

    const newPost = {
      id: Date.now(),
      type,
      title: title.trim(),
      content: content.trim(),
      author: usuario,
      replies: [],
    };

    setPosts((prevPosts) => [newPost, ...prevPosts]);

    // Limpiar formulario
    setType('');
    setTitle('');
    setContent('');
  };

  // Abrir/cerrar formulario de respuesta
  const toggleReply = (postId) => {
    setReplyOpen((prev) =>
      prev === postId ? null : postId
    );
  };

  // Escribir respuesta
  const handleReplyChange = (postId, value) => {
    setReplyText((prev) => ({
      ...prev,
      [postId]: value,
    }));
  };

  // Enviar respuesta
  const handleReplySubmit = (e, postId) => {
    e.preventDefault();

    if (!usuario) {
      alert('Debes iniciar sesión para responder.');
      return;
    }

    const text = replyText[postId]?.trim();

    if (!text) {
      return;
    }

    const newReply = {
      id: Date.now(),
      author: usuario,
      text,
    };

    setPosts((prevPosts) =>
      prevPosts.map((post) =>
        post.id === postId
          ? {
              ...post,
              replies: [...post.replies, newReply],
            }
          : post
      )
    );

    // Limpiar respuesta
    setReplyText((prev) => ({
      ...prev,
      [postId]: '',
    }));

    // Ocultar formulario
    setReplyOpen(null);
  };

  return (
    <>
      <Navbar />

      <main className="main-content container my-5">

        {/* TÍTULO */}
        <div className="text-center mb-5">
