<file path="src/assets/css/login.css">
/* ========================================
   ESTILOS ESPECÍFICOS DEL LOGIN
   ======================================== */

/* CONTENEDOR PRINCIPAL DEL LOGIN */

.login-page {
  min-height: calc(100vh - 70px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 0;
  background-color: #f0f4f8;
}


/* TARJETA DE LOGIN */

.login-card {
  background: white;
  border-radius: 16px;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  padding: 2.5rem 2rem;
  max-width: 420px;
  width: 100%;
  transition: transform 0.2s;
}

.login-card:hover {
  transform: translateY(-5px);
}


/* LOGO */

.login-card .logo {
  text-align: center;
  margin-bottom: 1.8rem;
}

.login-card .logo i {
  font-size: 3rem;
  color: #007bff;
}

.login-card .logo h2 {
  font-weight: 600;
  color: #2d3436;
  margin-top: 0.5rem;
}


/* INPUTS */

.login-card .form-control {
  height: 50px;
  border-radius: 8px;
  border: 1px solid #dfe6e9;
  padding-left: 1rem;
  font-size: 1rem;
  transition: border-color 0.3s;
}

.login-card .form-control:focus {
  border-color: #007bff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.login-card .input-group-text {
  background: transparent;
  border: none;
  color: #6c757d;
  padding-right: 0;
}


/* BOTÓN LOGIN */

.login-card .btn-login {
  width: 100%;
  padding: 0.7rem;
  font-size: 1.1rem;
  font-weight: 600;
  border-radius: 8px;
  background: linear-gradient(135deg, #007bff, #0056b3);
  border: none;
  color: white;
  transition: all 0.3s;
  margin-top: 0.5rem;
}

.login-card .btn-login:hover {
  background: linear-gradient(135deg, #0056b3, #003d80);
  transform: scale(1.02);
}


/* OLVIDÉ MI CONTRASEÑA */

.login-card .forgot-link {
  text-align: right;
  font-size: 0.9rem;
  margin-top: 0.3rem;
}

.login-card .forgot-link a {
  color: #6c757d;
  text-decoration: none;
}

.login-card .forgot-link a:hover {
  color: #007bff;
  text-decoration: underline;
}


/* REGISTRO */

.login-card .register-link {
  text-align: center;
  margin-top: 1.5rem;
  font-size: 0.95rem;
  color: #6c757d;
}

.login-card .register-link a {
  color: #007bff;
  font-weight: 500;
  text-decoration: none;
}

.login-card .register-link a:hover {
  text-decoration: underline;
}


/* VOLVER AL INICIO */

.login-card .back-home {
  text-align: center;
  margin-top: 1rem;
}

.login-card .back-home a {
  color: #6c757d;
  text-decoration: none;
  font-size: 0.9rem;
}

.login-card .back-home a:hover {
  color: #007bff;
}


/* RESPONSIVO */

@media (max-width: 576px) {
  .login-card {
    padding: 2rem 1.5rem;
    margin: 0 1rem;
  }
}
</file>

<file path="src/assets/css/style.css">
