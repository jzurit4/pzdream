<file path="src/hooks/useFilteredProducts.js">
import { useMemo } from 'react';

export function useFilteredProducts(productos, { categoria, q } = {}) {
  return useMemo(() => {
    const term = (q || '').toLowerCase().trim();
    return productos.filter((p) => {
      const okCat = !categoria || p.categoria === categoria;
      const okQ =
        !term ||
        p.nombre.toLowerCase().includes(term) ||
        p.descripcion?.toLowerCase().includes(term);
      return okCat && okQ;
    });
  }, [productos, categoria, q]);
}
</file>

<file path="src/hooks/useLocalStorage.js">
import { useEffect, useState } from 'react';

export function useLocalStorage(key, initial) {
  const [value, setValue] = useState(() => {
    try {
      const item = localStorage.getItem(key);
      return item ? JSON.parse(item) : initial;
    } catch {
      return initial;
    }
  });

  useEffect(() => {
    try {
      localStorage.setItem(key, JSON.stringify(value));
    } catch (e) {
      console.warn(`No se pudo guardar ${key}`, e);
    }
  }, [key, value]);

  return [value, setValue];
}
</file>

<file path="src/pages/admin/AdminAgregar.jsx">
import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import AdminLayout from '../../components/admin/AdminLayout';
import { useProducts } from '../../context/ProductsContext';
import { CATEGORIAS } from '../../data/productos';

function AdminAgregar() {
  const navigate = useNavigate();
  const { agregarProducto } = useProducts();

  const [form, setForm] = useState({
    nombre: '',
    precio: '',
    precioOriginal: '',
    stock: '',
    imagen: '',
    descripcion: '',
    categoria: 'notebook',
    oferta: false,
  });

  const [mensaje, setMensaje] = useState(null);

  const handleChange = (e) => {
    const { name, value, type, checked } = e.target;
    setForm((prev) => ({ ...prev, [name]: type === 'checkbox' ? checked : value }));
  };

  const handleSubmit = (e) => {
    e.preventDefault();

    if (!form.nombre.trim() || !form.precio || !form.stock) {
      setMensaje({ type: 'danger', text: 'Completa los campos obligatorios.' });
      return;
    }

    agregarProducto({
      ...form,
      precio: Number(form.precio),
      precioOriginal: form.precioOriginal ? Number(form.precioOriginal) : null,
      stock: Number(form.stock),
    });

    setMensaje({ type: 'success', text: `Producto "${form.nombre}" agregado correctamente.` });
    setTimeout(() => navigate('/admin/lista'), 1200);
  };

  return (
    <AdminLayout title="Agregar Producto" subtitle="Completa los campos para añadir un nuevo producto">
      <div className="row justify-content-center">
        <div className="col-lg-8">
          <div className="card shadow-sm">
            <div className="card-body">
              <form className="admin-form" onSubmit={handleSubmit}>
                <div className="row g-3">
                  <div className="col-md-6">
                    <label className="form-label">Nombre *</label>
                    <input type="text" className="form-control" name="nombre" value={form.nombre} onChange={handleChange} placeholder="Ej: Notebook Gamer" required />
                  </div>
                  <div className="col-md-6">
                    <label className="form-label">Categoría</label>
                    <select className="form-select" name="categoria" value={form.categoria} onChange={handleChange}>
                      {CATEGORIAS.map((c) => (
                        <option key={c.slug} value={c.slug}>{c.label}</option>
                      ))}
                    </select>
                  </div>
                  <div className="col-md-6">
                    <label className="form-label">Precio (CLP) *</label>
                    <input type="number" className="form-control" name="precio" value={form.precio} onChange={handleChange} placeholder="1299990" required />
                  </div>
                  <div className="col-md-6">
                    <label className="form-label">Precio original (si está en oferta)</label>
                    <input type="number" className="form-control" name="precioOriginal" value={form.precioOriginal} onChange={handleChange} placeholder="1499990" />
                  </div>
                  <div className="col-md-6">
                    <label className="form-label">Stock *</label>
                    <input type="number" className="form-control" name="stock" value={form.stock} onChange={handleChange} placeholder="10" required />
                  </div>
                  <div className="col-md-6 d-flex align-items-end">
                    <div className="form-check">
                      <input className="form-check-input" type="checkbox" name="oferta" id="oferta" checked={form.oferta} onChange={handleChange} />
                      <label className="form-check-label" htmlFor="oferta">Marcar como oferta</label>
                    </div>
                  </div>
                  <div className="col-12">
                    <label className="form-label">URL de la imagen</label>
                    <input type="text" className="form-control" name="imagen" value={form.imagen} onChange={handleChange} placeholder="https://..." />
                  </div>
                  <div className="col-12">
                    <label className="form-label">Descripción</label>
                    <textarea className="form-control" name="descripcion" rows="3" value={form.descripcion} onChange={handleChange}></textarea>
                  </div>
                </div>

                {mensaje && <div className={`alert alert-${mensaje.type} mt-3 mb-0`}>{mensaje.text}</div>}

                <div className="d-flex gap-2 mt-4">
                  <button type="submit" className="btn btn-primary">
                    <i className="fas fa-save me-2"></i>Guardar producto
                  </button>
                  <button type="button" className="btn btn-outline-secondary" onClick={() => navigate('/admin')}>
                    <i className="fas fa-arrow-left me-2"></i>Cancelar
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </AdminLayout>
  );
}

export default AdminAgregar;
</file>

<file path="src/pages/admin/AdminEliminar.jsx">
import { useState } from 'react';
import { useSearchParams, useNavigate } from 'react-router-dom';
import AdminLayout from '../../components/admin/AdminLayout';
import { useProducts } from '../../context/ProductsContext';
import { formatCLP } from '../../utils/format';

function AdminEliminar() {
  const navigate = useNavigate();
  const [searchParams] = useSearchParams();
  const { productos, eliminarProducto, getProducto } = useProducts();

  const idUrl = searchParams.get('id') || '';
  const [id, setId] = useState(idUrl);
  const [mensaje, setMensaje] = useState(null);

  const producto = id ? getProducto(id) : null;

  const handleEliminar = () => {
    if (!producto) return;
    const confirmado = confirm(`¿Eliminar "${producto.nombre}"? Esta acción no se puede deshacer.`);
    if (!confirmado) return;

    eliminarProducto(producto.id);
    setMensaje({ type: 'success', text: `"${producto.nombre}" eliminado correctamente.` });
    setId('');
    setTimeout(() => navigate('/admin/lista'), 1200);
  };

  return (
    <AdminLayout title="Eliminar Producto" subtitle="Selecciona un producto para eliminarlo permanentemente">
      <div className="row justify-content-center">
        <div className="col-lg-6">
          <div className="card shadow-sm">
            <div className="card-body">
              <div className="mb-4">
                <label className="form-label fw-semibold">Selecciona el producto</label>
                <select className="form-select" value={id} onChange={(e) => { setId(e.target.value); setMensaje(null); }}>
                  <option value="">-- Seleccionar --</option>
                  {productos.map((p) => (
                    <option key={p.id} value={p.id}>#{p.id} — {p.nombre}</option>
                  ))}
                </select>
              </div>

              {producto && (
                <div className="alert alert-warning">
                  <h6 className="mb-2"><i className="fas fa-exclamation-triangle me-2"></i>Vas a eliminar:</h6>
                  <div className="d-flex align-items-center gap-3">
                    <img src={producto.imagen} alt={producto.nombre} style={{ width: 60, height: 60, objectFit: 'contain' }} />
                    <div>
                      <div className="fw-bold">{producto.nombre}</div>
                      <div className="small text-muted">{formatCLP(producto.precio)} · {producto.categoria}</div>
                    </div>
                  </div>
                </div>
              )}

              {mensaje && <div className={`alert alert-${mensaje.type}`}>{mensaje.text}</div>}

              <div className="d-flex gap-2">
                <button type="button" className="btn btn-danger" onClick={handleEliminar} disabled={!producto}>
                  <i className="fas fa-trash me-2"></i>Eliminar producto
                </button>
                <button type="button" className="btn btn-outline-secondary" onClick={() => navigate('/admin')}>
                  <i className="fas fa-arrow-left me-2"></i>Cancelar
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </AdminLayout>
  );
}

export default AdminEliminar;
</file>

