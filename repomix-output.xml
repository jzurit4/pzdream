  height: 100%;
}

.about-feature:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
}

.about-feature i {
  color: #007bff;
}

.about-feature h5 {
  font-weight: 600;
  color: #2d3436;
}

/* RESPONSIVO*/
@media (max-width: 768px) {
  .about-banner {
    height: 250px;
  }
  .about-banner-title {
    font-size: 2.2rem;
  }
  .about-banner-sub {
    font-size: 1rem;
  }
  .about-text {
    font-size: 1rem;
  }
}

@media (max-width: 576px) {
  .about-banner {
    height: 200px;
  }
  .about-banner-title {
    font-size: 1.6rem;
  }
}
/* ===== ESTILOS PARA PÁGINA DE DETALLE DE PRODUCTO ===== */
