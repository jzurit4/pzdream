import { useState, useEffect } from 'react';
import { useSearchParams, useNavigate } from 'react-router-dom';
import AdminLayout from '../../components/admin/AdminLayout';
import { useProducts } from '../../context/ProductsContext';
import { CATEGORIAS } from '../../data/productos';
import { formatCLP } from '../../utils/format';

function AdminModificar() {
  const navigate = useNavigate();
  const [searchParams] = useSearchParams();
  const { productos, modificarProducto, getProducto } = useProducts();

  const idUrl = searchParams.get('id') || '';
  const [id, setId] = useState(idUrl);
  const [form, setForm] = useState(null);
  const [mensaje, setMensaje] = useState(null);

  useEffect(() => {
    if (!id) { setForm(null); return; }
    const p = getProducto(id);
    if (p) {
      setForm({
        nombre: p.nombre || '',
        precio: p.precio ?? '',
        precioOriginal: p.precioOriginal ?? '',
        stock: p.stock ?? '',
        imagen: p.imagen || '',
        descripcion: p.descripcion || '',
        categoria: p.categoria || 'notebook',
        oferta: Boolean(p.oferta),
      });
      setMensaje(null);
    } else {
      setForm(null);
    }
  }, [id, getProducto]);

  const handleChange = (e) => {
    const { name, value, type, checked } = e.target;
    setForm((prev) => ({ ...prev, [name]: type === 'checkbox' ? checked : value }));
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    if (!form.nombre.trim() || form.precio === '' || form.stock === '') {
      setMensaje({ type: 'danger', text: 'Completa los campos obligatorios.' });
      return;
    }

    modificarProducto(id, {
      ...form,
      precio: Number(form.precio),
      precioOriginal: form.precioOriginal ? Number(form.precioOriginal) : null,
      stock: Number(form.stock),
    });

    setMensaje({ type: 'success', text: `Producto "${form.nombre}" actualizado.` });
  };

  return (
    <AdminLayout title="Modificar Producto" subtitle="Selecciona un producto y actualiza sus datos">
      <div className="row justify-content-center">
        <div className="col-lg-8">
          <div className="card shadow-sm">
            <div className="card-body">
              <div className="mb-4">
                <label className="form-label fw-semibold">Seleccionar producto</label>
                <select className="form-select" value={id} onChange={(e) => setId(e.target.value)}>
                  <option value="">-- Seleccionar --</option>
                  {productos.map((p) => (
                    <option key={p.id} value={p.id}>#{p.id} — {p.nombre} ({formatCLP(p.precio)})</option>
                  ))}
                </select>
              </div>

              {form && (
                <form className="admin-form" onSubmit={handleSubmit}>
                  <div className="row g-3">
                    <div className="col-md-6">
                      <label className="form-label">Nombre</label>
                      <input type="text" className="form-control" name="nombre" value={form.nombre} onChange={handleChange} required />
                    </div>
                    <div className="col-md-6">
                      <label className="form-label">Categoría</label>
                      <select className="form-select" name="categoria" value={form.categoria} onChange={handleChange}>
                        {CATEGORIAS.map((c) => (
                          <option key={c.slug} value={c.slug}>{c.label}</option>
                        ))}
                      </select>
                    </div>
                    <div className="col-md-6">
                      <label className="form-label">Precio (CLP)</label>
                      <input type="number" className="form-control" name="precio" value={form.precio} onChange={handleChange} required />
                    </div>
                    <div className="col-md-6">
                      <label className="form-label">Precio original</label>
                      <input type="number" className="form-control" name="precioOriginal" value={form.precioOriginal} onChange={handleChange} />
                    </div>
                    <div className="col-md-6">
                      <label className="form-label">Stock</label>
                      <input type="number" className="form-control" name="stock" value={form.stock} onChange={handleChange} required />
                    </div>
                    <div className="col-md-6 d-flex align-items-end">
                      <div className="form-check">
                        <input className="form-check-input" type="checkbox" name="oferta" id="oferta" checked={form.oferta} onChange={handleChange} />
                        <label className="form-check-label" htmlFor="oferta">Marcar como oferta</label>
                      </div>
                    </div>
                    <div className="col-12">
                      <label className="form-label">URL imagen</label>
                      <input type="text" className="form-control" name="imagen" value={form.imagen} onChange={handleChange} />
                    </div>
                    <div className="col-12">
                      <label className="form-label">Descripción</label>
                      <textarea className="form-control" name="descripcion" rows="3" value={form.descripcion} onChange={handleChange}></textarea>
                    </div>
                  </div>

                  {mensaje && <div className={`alert alert-${mensaje.type} mt-3 mb-0`}>{mensaje.text}</div>}

                  <div className="d-flex gap-2 mt-4">
                    <button type="submit" className="btn btn-primary">
                      <i className="fas fa-save me-2"></i>Guardar cambios
                    </button>
                    <button type="button" className="btn btn-outline-secondary" onClick={() => navigate('/admin')}>
                      <i className="fas fa-arrow-left me-2"></i>Cancelar
                    </button>
                  </div>
                </form>
              )}

              {!form && id && <div className="alert alert-warning">No se encontró el producto con ID #{id}.</div>}
              {!id && (
                <div className="text-muted text-center py-4">
                  <i className="fas fa-hand-point-up fa-2x mb-2"></i>
                  <p className="mb-0">Selecciona un producto para editar sus datos.</p>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </AdminLayout>
  );
}

export default AdminModificar;
</file>

<file path="src/pages/carrito.jsx">
import { Link } from 'react-router-dom';

import Layout from '../components/layout/Layout';
import ProductCardMini from '../components/productos/ProductCardMini';
import { useCart } from '../context/CartContext';
import { useProducts } from '../context/ProductsContext';
import { formatCLP } from '../utils/format';

import '../assets/css/carrito.css';

function Carrito() {
  const { items, total, count, change, remove, clear } = useCart();
  const { productos } = useProducts();

  const finalizarCompra = () => {
    if (items.length === 0) return;
    alert('¡Compra finalizada! Gracias por tu pedido.');
    clear();
  };

  return (
    <Layout>
      <h1 className="display-5 fw-bold mb-4">
        <i className="fas fa-shopping-cart text-primary me-2"></i>
        Carrito de compras
      </h1>

      <div className="row g-4">
        <div className="col-lg-8">
          <h4 className="fw-semibold mb-3">
            <i className="fas fa-boxes text-primary me-2"></i>
            Productos disponibles
          </h4>
          <div className="row g-3">
            {productos.map((p) => (
              <ProductCardMini key={p.id} producto={p} />
            ))}
          </div>
        </div>

        <div className="col-lg-4">
          <div className="cart-summary">
            <h4 className="fw-semibold mb-3">
              <i className="fas fa-receipt text-primary me-2"></i>
              Resumen
            </h4>

            {items.length === 0 ? (
              <div className="text-muted text-center py-4">
                <i className="fas fa-cart-plus fa-3x mb-3"></i>
                <p>Tu carrito está vacío</p>
              </div>
            ) : (
              <>
                <ul className="list-group list-group-flush mb-3">
                  {items.map((item) => (
                    <li className="list-group-item cart-item" key={item.id}>
                      <div className="item-info">
                        <div className="item-name">{item.nombre}</div>
                        <div className="item-price">{formatCLP(item.precio)} c/u</div>
                      </div>
                      <div className="item-actions">
                        <button
                          className="btn btn-outline-secondary btn-sm"
                          onClick={() => change(item.id, -1)}
                        >
                          −
                        </button>
                        <span className="cantidad">{item.cantidad}</span>
                        <button
                          className="btn btn-outline-secondary btn-sm"
                          onClick={() => change(item.id, 1)}
                        >
                          +
                        </button>
                        <button
                          className="btn btn-danger btn-sm"
                          onClick={() => remove(item.id)}
                        >
                          <i className="fas fa-trash-alt"></i>
                        </button>
                      </div>
                    </li>
                  ))}
                </ul>

                <div className="d-flex justify-content-between fw-bold fs-5">
                  <span>Total ({count} ítems):</span>
                  <span>{formatCLP(total)}</span>
                </div>

                <button className="btn btn-danger w-100 mt-3" onClick={clear}>
                  <i className="fas fa-trash-alt me-2"></i>Vaciar carrito
                </button>
                <button className="btn btn-success w-100 mt-2" onClick={finalizarCompra}>
                  <i className="fas fa-check me-2"></i>Finalizar compra
                </button>
              </>
            )}
          </div>
        </div>
      </div>
    </Layout>
  );
}

export default Carrito;
</file>

<file path="src/pages/catalogo.jsx">
import { useState, useMemo } from 'react';
import { useSearchParams } from 'react-router-dom';

import Layout from '../components/layout/Layout';
import ProductCard from '../components/productos/ProductCard';
import { useProducts } from '../context/ProductsContext';
import { CATEGORIAS } from '../data/productos';

import '../assets/css/catalogo.css';

function Catalogo() {
  const { productos } = useProducts();
  const [searchParams, setSearchParams] = useSearchParams();
  const [busqueda, setBusqueda] = useState('');

  const categoriaActiva = searchParams.get('categoria') || '';

  const filtrados = useMemo(() => {
    const term = busqueda.toLowerCase().trim();
    return productos.filter((p) => {
      const okCat = !categoriaActiva || p.categoria === categoriaActiva;
      const okQ =
        !term ||
        p.nombre.toLowerCase().includes(term) ||
        p.descripcion?.toLowerCase().includes(term);
      return okCat && okQ;
    });
  }, [productos, categoriaActiva, busqueda]);

  const setCategoria = (slug) => {
    if (slug) setSearchParams({ categoria: slug });
    else setSearchParams({});
  };

  return (
    <Layout>
      <h1 className="page-title mb-3">
        <i className="fas fa-th-large me-2 text-primary"></i>
        Catálogo de Productos
      </h1>

      {/* Filtros por categoría */}
      <div className="mb-3 d-flex flex-wrap gap-2">
        <button
          type="button"
          className={`btn btn-sm ${!categoriaActiva ? 'btn-primary' : 'btn-outline-primary'}`}
          onClick={() => setCategoria('')}
        >
          Todos
        </button>
        {CATEGORIAS.map((c) => (
          <button
            key={c.slug}
            type="button"
            className={`btn btn-sm ${categoriaActiva === c.slug ? 'btn-primary' : 'btn-outline-primary'}`}
            onClick={() => setCategoria(c.slug)}
          >
            <i className={`fas ${c.icon} me-1`}></i>
            {c.label}
          </button>
        ))}
      </div>

      {/* Buscador */}
      <div className="mb-3">
        <input
          type="search"
          className="form-control"
          placeholder="Buscar productos..."
          value={busqueda}
          onChange={(e) => setBusqueda(e.target.value)}
        />
      </div>

      <span className="badge bg-primary fs-6 mb-4">
        {filtrados.length} {filtrados.length === 1 ? 'producto' : 'productos'}
      </span>

      {filtrados.length === 0 ? (
        <div className="text-center py-5">
          <i className="fas fa-box-open fa-3x text-muted mb-3"></i>
          <p className="text-muted">No hay productos que coincidan.</p>
          <button
            className="btn btn-primary"
            onClick={() => { setCategoria(''); setBusqueda(''); }}
          >
            Ver todos
          </button>
        </div>
      ) : (
        <div className="row g-4">
          {filtrados.map((p) => (
            <ProductCard key={p.id} producto={p} />
          ))}
        </div>
      )}
    </Layout>
  );
}

export default Catalogo;
</file>

